<Window x:Class="PerAppAudio.App.Wpf.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Osd" Height="72" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False">
    <Border Background="#CC1B1B1B" CornerRadius="10" Padding="16,10">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Text="🔊" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="MessageText" Text="" Foreground="White" FontSize="14"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
        </StackPanel>
    </Border>
</Window>
