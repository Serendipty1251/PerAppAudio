<Window x:Class="PerAppAudio.App.Wpf.SoundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:PerAppAudio.App.Wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Loc SpEditorTitle}"
        Height="520" Width="980" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <!-- 顶部信息条 -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
            <TextBlock x:Name="FileNameText" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MetaText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </DockPanel>

        <!-- 底部操作条 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc SpEditorStart}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider Grid.Column="1" x:Name="StartSlider" Minimum="0" Maximum="100" TickFrequency="1"
                        ValueChanged="RangeSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" Text="{loc:Loc SpEditorEnd}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <Slider Grid.Column="3" x:Name="EndSlider" Minimum="0" Maximum="100" TickFrequency="1"
                        ValueChanged="RangeSlider_ValueChanged"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="SelInfoText" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PreviewBtn" Content="{loc:Loc SpEditorPreview}" Style="{StaticResource GhostButton}"
                            Click="PreviewBtn_Click" Margin="0,0,6,0"/>
                    <Button x:Name="StopPreviewBtn" Content="{loc:Loc SpEditorStop}" Style="{StaticResource GhostButton}"
                            Click="StopPreviewBtn_Click" Margin="0,0,6,0" IsEnabled="False"/>
                    <Button x:Name="ExportSelBtn" Content="{loc:Loc SpEditorExportSel}" Style="{StaticResource PrimaryButton}"
                            Click="ExportSelBtn_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ExportWholeBtn" Content="{loc:Loc SpEditorExportWhole}" Style="{StaticResource GhostButton}"
                            Click="ExportWholeBtn_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 波形区 -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}">
            <Canvas x:Name="WaveCanvas" Width="940" Height="300" ClipToBounds="True" SizeChanged="WaveCanvas_SizeChanged">
                <Rectangle x:Name="DimStartRect" Fill="#40000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="DimEndRect" Fill="#40000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="StartLine" Width="2" Fill="#E0524B" IsHitTestVisible="False"/>
                <Rectangle x:Name="EndLine" Width="2" Fill="#E0524B" IsHitTestVisible="False"/>
            </Canvas>
        </Border>
    </DockPanel>
</Window>
