<Window x:Class="PerAppAudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PerAppAudio — 每应用音频输出路由"
        Height="680" Width="1060" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Icon="app-icon.ico"
        Closing="Window_Closing">
    <DockPanel>
        <!-- 品牌头部 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandBrush}" Padding="16,10">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="app-icon.ico" Width="26" Height="26" Margin="0,0,10,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="场景:" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="ProfileBox" Width="160" Margin="8,0,0,0"/>
                    <Button x:Name="ApplyProfileButton" Content="应用" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="ApplyProfile_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PerAppAudio" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProbeText" Foreground="#D6E4F7" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="10" Padding="0" BorderThickness="0">
            <!-- Tab 1：正在播放 -->
            <TabItem Header="正在播放">
                <DockPanel Margin="8">
                    <!-- 工具条 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged"
                                 ToolTip="按进程名或会话名过滤"/>
                        <CheckBox x:Name="OnlyPlayingCheck" Grid.Column="2" Content="仅显示播放中" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <TextBlock Grid.Column="3"/>
                        <Button Grid.Column="4" Content="刷新" Style="{StaticResource GhostButton}"
                                Click="RefreshNow_Click" Margin="0,0,8,0"/>
                        <CheckBox x:Name="AutoRefreshCheck" Grid.Column="5" Content="自动刷新(10s)" IsChecked="False"
                                  VerticalAlignment="Center" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="自动检测有音频会话的应用；选输出设备、调音量后点「应用」立即改道并持久化。"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>

                    <DataGrid x:Name="PlayingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="状态" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding StateBrush}"/>
                                            <TextBlock Text="{Binding State}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="会话" Binding="{Binding DisplayName}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="当前设备" Binding="{Binding CurrentDevice}" Width="150" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="输出设备" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="音量" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                Width="94" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="应用" Style="{StaticResource PrimaryButton}" Padding="10,3"
                                                IsEnabled="{Binding CanApply}" Click="ApplySession_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="PlayingEmptyHint" DockPanel.Dock="Top" Text="未检测到音频会话的应用。让应用播放一次声音后会出现在这里。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,16,0,0"/>
                </DockPanel>
            </TabItem>

            <!-- Tab 2：路由表 -->
            <TabItem Header="路由表">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="持久路由：应用启动即按此表自动路由（2–4 秒内生效）。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="重新应用全部" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                Click="ReapplyAll_Click" ToolTip="对当前运行中的匹配进程重新应用路由"/>
                    </StackPanel>

                    <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="目标设备" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="Device_Changed" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="手段" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" SelectionChanged="Mode_Changed" Margin="4,0">
                                            <ComboBoxItem Content="自动" Tag="auto"/>
                                            <ComboBoxItem Content="A 实时" Tag="a"/>
                                            <ComboBoxItem Content="B 持久" Tag="b"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="音量" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="Volume_Changed" Width="94" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="移除" Style="{StaticResource GhostButton}" Padding="8,2"
                                                Click="Remove_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 3：日志 -->
            <TabItem Header="日志">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="清空" Style="{StaticResource GhostButton}" Click="ClearLog_Click"/>
                        <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
