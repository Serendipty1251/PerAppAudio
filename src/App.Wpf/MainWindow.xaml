<Window x:Class="PerAppAudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:PerAppAudio.App.Wpf"
        xmlns:local="clr-namespace:PerAppAudio.App.Wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Loc AppTitle}"
        Height="680" Width="1060" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Icon="app-icon.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- 设备名展示转换：裸名（存储）↔ 去歧义展示名（界面） -->
        <local:DeviceNameConverter x:Key="DeviceNameConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="4,0">
            <MenuItem Header="{loc:Loc MenuEdit}">
                <MenuItem Header="{loc:Loc MenuRefresh}" InputGestureText="F5" Click="MenuRefresh_Click"/>
                <MenuItem Header="{loc:Loc MenuClearLog}" Click="MenuClearLog_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc MenuTools}">
                <MenuItem Header="{loc:Loc MenuReapplyAll}" Click="MenuReapplyAll_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc MenuOpenRoutes}" Click="MenuOpenRoutes_Click"/>
                <MenuItem Header="{loc:Loc MenuOpenRules}" Click="MenuOpenRules_Click"/>
                <MenuItem Header="{loc:Loc MenuOpenLog}" Click="MenuOpenLog_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc MenuWindow}">
                <MenuItem Header="{loc:Loc MenuTabPlaying}" Click="MenuTabPlaying_Click"/>
                <MenuItem Header="{loc:Loc MenuTabRoutes}" Click="MenuTabRoutes_Click"/>
                <MenuItem Header="{loc:Loc MenuTabLive}" Click="MenuTabLive_Click"/>
                <MenuItem Header="{loc:Loc MenuTabLog}" Click="MenuTabLog_Click"/>
                <MenuItem Header="{loc:Loc MenuTabSoundpad}" Click="MenuTabSoundpad_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc MenuMinimize}" Click="MenuMinimizeToTray_Click"/>
                <MenuItem Header="{loc:Loc MenuExit}" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc MenuHelp}">
                <MenuItem Header="{loc:Loc MenuUsage}" Click="MenuUsage_Click"/>
                <MenuItem Header="{loc:Loc MenuAbout}" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 品牌头部 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandBrush}" Padding="16,10">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="app-icon.ico" Width="26" Height="26" Margin="0,0,10,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc LabelProfile}" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="ProfileBox" Width="160" Margin="8,0,0,0"/>
                    <Button x:Name="ApplyProfileButton" Content="{loc:Loc BtnApply}" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="ApplyProfile_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PerAppAudio" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProbeText" Foreground="#D6E4F7" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="10" Padding="0" BorderThickness="0">
            <!-- Tab 1：正在播放 -->
            <TabItem Header="{loc:Loc TabPlaying}">
                <DockPanel Margin="8">
                    <!-- 工具条 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc LabelSearch}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged"
                                 ToolTip="{loc:Loc TipSearchSession}"/>
                        <CheckBox x:Name="OnlyPlayingCheck" Grid.Column="2" Content="{loc:Loc CheckOnlyPlaying}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <TextBlock Grid.Column="3"/>
                        <Button Grid.Column="4" Content="{loc:Loc BtnRefresh}" Style="{StaticResource GhostButton}"
                                Click="RefreshNow_Click" Margin="0,0,8,0"/>
                        <CheckBox x:Name="AutoRefreshCheck" Grid.Column="5" Content="{loc:Loc CheckAutoRefresh}" IsChecked="False"
                                  VerticalAlignment="Center" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc HintPlaying}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>

                    <DataGrid x:Name="PlayingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc ColState}" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding StateBrush}"/>
                                            <TextBlock Text="{Binding State}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc ColProcess}" Binding="{Binding ProcessName}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColSession}" Binding="{Binding DisplayName}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColCurrentDevice}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CurrentDevice" Converter="{StaticResource DeviceNameConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{loc:Loc ColTargetDevice}" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DeviceName, Converter={StaticResource DeviceNameConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Loc ColVolume}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                Width="94" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Loc BtnApplyRow}" Style="{StaticResource PrimaryButton}" Padding="10,3"
                                                IsEnabled="{Binding CanApply}" Click="ApplySession_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="PlayingEmptyHint" DockPanel.Dock="Top" Text="{loc:Loc HintNoSessions}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,16,0,0"/>
                </DockPanel>
            </TabItem>

            <!-- Tab 2：路由表 -->
            <TabItem Header="{loc:Loc TabRoutes}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc HintRoutes}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="{loc:Loc BtnReapplyAll}" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                Click="ReapplyAll_Click" ToolTip="{loc:Loc TipReapply}"/>
                    </StackPanel>

                    <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc ColProcess}" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="{loc:Loc ColTargetDevice}" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DeviceName, Converter={StaticResource DeviceNameConverter}, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="Device_Changed" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Loc ColMode}" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" SelectionChanged="Mode_Changed" Margin="4,0">
                                            <ComboBoxItem Content="{loc:Loc ModeAuto}" Tag="auto"/>
                                            <ComboBoxItem Content="{loc:Loc ModeA}" Tag="a"/>
                                            <ComboBoxItem Content="{loc:Loc ModeB}" Tag="b"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Loc ColVolume}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="Volume_Changed" Width="94" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc ColStatus}" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Loc BtnRemove}" Style="{StaticResource GhostButton}" Padding="8,2"
                                                Click="Remove_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 3：活动链路 -->
            <TabItem Header="{loc:Loc TabLive}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc HintLive}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock x:Name="LiveEmptyHint" DockPanel.Dock="Top" Text="{loc:Loc HintNoLive}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,8"/>

                    <DataGrid x:Name="LiveGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc ColProcess}" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColPid}" Binding="{Binding ProcessId}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColTargetDevice}" Width="220" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="DeviceName" Converter="{StaticResource DeviceNameConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc ColMode}" Binding="{Binding ModeText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColLoopback}" Binding="{Binding LoopbackText}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColEndpoint}" Binding="{Binding EndpointText}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="{loc:Loc ColAppliedAt}" Binding="{Binding AppliedAtText}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Loc BtnBreak}" Style="{StaticResource GhostButton}" Padding="8,2"
                                                Click="BreakLink_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 4：日志 -->
            <TabItem Header="{loc:Loc TabLog}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc LabelSearch}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="LogSearchBox" Width="180" TextChanged="LogSearch_TextChanged"
                                 ToolTip="{loc:Loc TipSearchLog}"/>
                        <TextBlock Text="{loc:Loc LabelLevel}" VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="LogLevelBox" Width="90" SelectedIndex="0" SelectionChanged="LogLevel_Changed">
                            <ComboBoxItem Content="{loc:Loc LevelAll}"/>
                            <ComboBoxItem Content="{loc:Loc LevelInfo}"/>
                            <ComboBoxItem Content="{loc:Loc LevelWarn}"/>
                            <ComboBoxItem Content="{loc:Loc LevelError}"/>
                        </ComboBox>
                        <Button Content="{loc:Loc BtnClear}" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="ClearLog_Click"/>
                        <CheckBox x:Name="AutoScrollCheck" Content="{loc:Loc CheckAutoScroll}" IsChecked="True" Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox x:Name="LogList" Background="White" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{Binding LevelBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- Tab 5：音板 -->
            <TabItem Header="{loc:Loc TabSoundpad}">
                <DockPanel Margin="8">
                    <!-- 工具条 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc SpDevice}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="SoundpadDeviceBox" Width="200" SelectionChanged="SoundpadDevice_Changed"
                                  ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <CheckBox x:Name="SoundpadToMicCheck" Content="{loc:Loc SpToMic}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="SoundpadOption_Changed" Unchecked="SoundpadOption_Changed"/>
                        <TextBlock Text="{loc:Loc SpVolume}" VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Slider x:Name="SoundpadVolumeSlider" Width="100" Minimum="0" Maximum="1"
                                VerticalAlignment="Center" ValueChanged="SoundpadVolume_ValueChanged"/>
                        <Button Content="{loc:Loc SpStopAll}" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                Click="SoundpadStopAll_Click"/>
                        <Button Content="{loc:Loc SpOpenFolder}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="SoundpadOpenFolder_Click"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc SpHint}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock x:Name="SoundpadEmptyHint" DockPanel.Dock="Top" Text="{loc:Loc SpEmpty}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="SoundButtons" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <!-- Tab 6：设置 -->
            <TabItem Header="{loc:Loc TabSettings}">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Loc SectionGeneral}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="{loc:Loc CheckStartWithWindows}"
                                  Margin="0,2" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <CheckBox x:Name="OsdEnabledCheck" Content="{loc:Loc CheckOsd}"
                                  Margin="0,6,2,2" Checked="SettingChanged" Unchecked="SettingChanged"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="{loc:Loc SectionLanguage}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{loc:Loc LabelLanguage}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="LanguageBox" Width="140" SelectionChanged="Language_Changed">
                                <ComboBoxItem Content="中文"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </StackPanel>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="{loc:Loc SectionPlaying}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{loc:Loc LabelRefreshInterval}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="RefreshIntervalBox" Width="100" SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="{loc:Loc Sec2}"/>
                                <ComboBoxItem Content="{loc:Loc Sec5}"/>
                                <ComboBoxItem Content="{loc:Loc Sec10}"/>
                                <ComboBoxItem Content="{loc:Loc Sec30}"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="DefaultAutoRefreshCheck" Content="{loc:Loc CheckDefaultAutoRefresh}"
                                  Margin="0,8,2,2" Checked="SettingChanged" Unchecked="SettingChanged"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="{loc:Loc SectionHotkeys}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <TextBlock Text="{loc:Loc HintHotkeyFormat}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc HkNextOutput}" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyNextOutputBox" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc HkVolumeUp}" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyVolumeUpBox" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc HkVolumeDown}" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeyVolumeDownBox" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc HkMute}" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="HotkeyMuteBox" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc HkShowWindow}" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="HotkeyShowWindowBox" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc HkShowFlyout}" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="HotkeyShowFlyoutBox" Margin="0,2"/>
                        </Grid>
                        <Button Content="{loc:Loc BtnApplyHotkeys}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="ApplyHotkeys_Click"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="{loc:Loc HintConfigPath}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
