<Window x:Class="PerAppAudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PerAppAudio.App.Wpf"
        mc:Ignorable="d"
        Title="PerAppAudio — 每应用音频输出路由"
        Height="640" Width="1020"
        Closing="Window_Closing">
    <DockPanel Margin="10">
        <!-- 顶部工具条 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="场景:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ProfileBox" Width="170" Margin="6,0,0,0"/>
            <Button x:Name="ApplyProfileButton" Content="应用场景" Padding="12,3" Margin="6,0,0,0" Click="ApplyProfile_Click"/>
            <TextBlock x:Name="ProbeText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#616161" FontSize="12"/>
        </StackPanel>

        <!-- 底部状态 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="启动中…"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <!-- Tab 1：正在播放（自动检测） -->
            <TabItem Header="正在播放">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Text="自动检测系统中有音频会话的应用；选择输出设备后点「应用」立即改道并持久化。"
                               Foreground="#616161" FontSize="12" Margin="0,0,0,6"/>
                    <DataGrid x:Name="PlayingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" IsReadOnly="False" SelectionMode="Single"
                              RowHeight="32" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="会话" Binding="{Binding DisplayName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="70" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="输出设备" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="音量" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="应用" Padding="8,2" Click="ApplySession_Click" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 2：路由表（持久化） -->
            <TabItem Header="路由表">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Text="持久路由：应用启动即按此表自动路由（2–4 秒内生效）。"
                               Foreground="#616161" FontSize="12" Margin="0,0,0,6"/>
                    <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              RowHeight="30" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="140" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="目标设备" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="Device_Changed" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="手段" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" SelectionChanged="Mode_Changed" FontSize="12">
                                            <ComboBoxItem Content="自动" Tag="auto"/>
                                            <ComboBoxItem Content="A 实时" Tag="a"/>
                                            <ComboBoxItem Content="B 持久" Tag="b"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="音量" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="Volume_Changed" Width="100" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="移除" Padding="6,0" Click="Remove_Click" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 3：日志 -->
            <TabItem Header="日志">
                <DockPanel Margin="6">
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
