<Window x:Class="PerAppAudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PerAppAudio.App.Wpf"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PerAppAudio — 每应用音频输出路由"
        Height="680" Width="1060" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Icon="app-icon.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- 设备名展示转换：裸名（存储）↔ 去歧义展示名（界面） -->
        <local:DeviceNameConverter x:Key="DeviceNameConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="4,0">
            <MenuItem Header="_编辑">
                <MenuItem Header="_刷新" InputGestureText="F5" Click="MenuRefresh_Click"/>
                <MenuItem Header="_清空日志" Click="MenuClearLog_Click"/>
            </MenuItem>
            <MenuItem Header="_工具">
                <MenuItem Header="重新应用全部路由(_A)" Click="MenuReapplyAll_Click"/>
                <Separator/>
                <MenuItem Header="打开路由表文件(_O)" Click="MenuOpenRoutes_Click"/>
                <MenuItem Header="打开规则文件(_U)" Click="MenuOpenRules_Click"/>
                <MenuItem Header="打开日志文件(_L)" Click="MenuOpenLog_Click"/>
            </MenuItem>
            <MenuItem Header="_窗口">
                <MenuItem Header="_正在播放" Click="MenuTabPlaying_Click"/>
                <MenuItem Header="_路由表" Click="MenuTabRoutes_Click"/>
                <MenuItem Header="活动链_路" Click="MenuTabLive_Click"/>
                <MenuItem Header="_日志" Click="MenuTabLog_Click"/>
                <Separator/>
                <MenuItem Header="_最小化到托盘" Click="MenuMinimizeToTray_Click"/>
                <MenuItem Header="_退出" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_帮助">
                <MenuItem Header="_使用说明" Click="MenuUsage_Click"/>
                <MenuItem Header="_关于" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 品牌头部 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandBrush}" Padding="16,10">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="app-icon.ico" Width="26" Height="26" Margin="0,0,10,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="场景:" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="ProfileBox" Width="160" Margin="8,0,0,0"/>
                    <Button x:Name="ApplyProfileButton" Content="应用" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="ApplyProfile_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PerAppAudio" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProbeText" Foreground="#D6E4F7" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="10" Padding="0" BorderThickness="0">
            <!-- Tab 1：正在播放 -->
            <TabItem Header="正在播放">
                <DockPanel Margin="8">
                    <!-- 工具条 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged"
                                 ToolTip="按进程名或会话名过滤"/>
                        <CheckBox x:Name="OnlyPlayingCheck" Grid.Column="2" Content="仅显示播放中" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <TextBlock Grid.Column="3"/>
                        <Button Grid.Column="4" Content="刷新" Style="{StaticResource GhostButton}"
                                Click="RefreshNow_Click" Margin="0,0,8,0"/>
                        <CheckBox x:Name="AutoRefreshCheck" Grid.Column="5" Content="自动刷新(10s)" IsChecked="False"
                                  VerticalAlignment="Center" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="自动检测有音频会话的应用；选输出设备、调音量后点「应用」立即改道并持久化。"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>

                    <DataGrid x:Name="PlayingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="状态" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding StateBrush}"/>
                                            <TextBlock Text="{Binding State}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="会话" Binding="{Binding DisplayName}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="当前设备" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CurrentDevice" Converter="{StaticResource DeviceNameConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="输出设备" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DeviceName, Converter={StaticResource DeviceNameConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="音量" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                Width="94" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="应用" Style="{StaticResource PrimaryButton}" Padding="10,3"
                                                IsEnabled="{Binding CanApply}" Click="ApplySession_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="PlayingEmptyHint" DockPanel.Dock="Top" Text="未检测到音频会话的应用。让应用播放一次声音后会出现在这里。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,16,0,0"/>
                </DockPanel>
            </TabItem>

            <!-- Tab 2：路由表 -->
            <TabItem Header="路由表">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="持久路由：应用启动即按此表自动路由（2–4 秒内生效）。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="重新应用全部" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                Click="ReapplyAll_Click" ToolTip="对当前运行中的匹配进程重新应用路由"/>
                    </StackPanel>

                    <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="目标设备" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DeviceName, Converter={StaticResource DeviceNameConverter}, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="Device_Changed" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="手段" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" SelectionChanged="Mode_Changed" Margin="4,0">
                                            <ComboBoxItem Content="自动" Tag="auto"/>
                                            <ComboBoxItem Content="A 实时" Tag="a"/>
                                            <ComboBoxItem Content="B 持久" Tag="b"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="音量" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="Volume_Changed" Width="94" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="移除" Style="{StaticResource GhostButton}" Padding="8,2"
                                                Click="Remove_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 3：活动链路 -->
            <TabItem Header="活动链路">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Coordinator 当前持有的实时路由。「断开」只拆活动链路、保留路由表记录（下次启动仍生效）；彻底删除请去「路由表」移除。"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock x:Name="LiveEmptyHint" DockPanel.Dock="Top" Text="暂无活动链路（应用一条路由后出现）"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,8"/>

                    <DataGrid x:Name="LiveGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="目标设备" Width="220" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="DeviceName" Converter="{StaticResource DeviceNameConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="手段" Binding="{Binding ModeText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="A 链路" Binding="{Binding LoopbackText}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="B2 端点" Binding="{Binding EndpointText}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="应用时间" Binding="{Binding AppliedAtText}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="断开" Style="{StaticResource GhostButton}" Padding="8,2"
                                                Click="BreakLink_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 4：日志 -->
            <TabItem Header="日志">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="LogSearchBox" Width="180" TextChanged="LogSearch_TextChanged"
                                 ToolTip="按内容过滤（不区分大小写）"/>
                        <TextBlock Text="级别:" VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="LogLevelBox" Width="90" SelectedIndex="0" SelectionChanged="LogLevel_Changed">
                            <ComboBoxItem Content="全部"/>
                            <ComboBoxItem Content="信息"/>
                            <ComboBoxItem Content="警告"/>
                            <ComboBoxItem Content="错误"/>
                        </ComboBox>
                        <Button Content="清空" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="ClearLog_Click"/>
                        <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox x:Name="LogList" Background="White" BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{Binding LevelBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- Tab 4：设置 -->
            <TabItem Header="设置">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="常规" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自启（随 Windows 启动自动运行，写入当前用户启动项）"
                                  Margin="0,2" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <CheckBox x:Name="OsdEnabledCheck" Content="操作时显示 OSD 提示（切换设备 / 调音量时屏幕角落弹出）"
                                  Margin="0,6,2,2" Checked="SettingChanged" Unchecked="SettingChanged"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="正在播放" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="自动刷新间隔:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="RefreshIntervalBox" Width="100" SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="2 秒"/>
                                <ComboBoxItem Content="5 秒"/>
                                <ComboBoxItem Content="10 秒"/>
                                <ComboBoxItem Content="30 秒"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="DefaultAutoRefreshCheck" Content="打开窗口时默认开启自动刷新"
                                  Margin="0,8,2,2" Checked="SettingChanged" Unchecked="SettingChanged"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="全局热键" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <TextBlock Text="格式：Ctrl+Alt+方向键/字母，清空 = 禁用。改后点「应用热键」立即生效。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="切换下一个输出设备:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyNextOutputBox" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="音量 +5%:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyVolumeUpBox" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="音量 -5%:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeyVolumeDownBox" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="静音切换:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="HotkeyMuteBox" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="显示主窗口:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="HotkeyShowWindowBox" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="打开托盘面板:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="HotkeyShowFlyoutBox" Margin="0,2"/>
                        </Grid>
                        <Button Content="应用热键" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="ApplyHotkeys_Click"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="配置存储于 %APPDATA%\PerAppAudio\ui.json；日志与路由表见「工具」菜单。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
