<Window x:Class="PerAppAudio.App.Wpf.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PerAppAudio.App.Wpf"
        xmlns:local="clr-namespace:PerAppAudio.App.Wpf"
        Title="TrayFlyout" Width="336" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize">
    <Window.Resources>
        <local:DeviceNameConverter x:Key="DeviceNameConverter"/>
    </Window.Resources>
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" Color="#3A3A3A"/>
        </Border.Effect>
        <DockPanel LastChildFill="False">
            <!-- 头部 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrandBrush}" CornerRadius="8,8,0,0" Padding="12,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="✕" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#D6E4F7"
                            FontSize="12" Cursor="Hand" Padding="6,2" VerticalAlignment="Center"
                            ToolTip="{loc:Loc TipClose}"/>
                    <StackPanel>
                        <TextBlock Text="PerAppAudio" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Foreground="#D6E4F7" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 正在播放 -->
            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{loc:Loc TipRowClick}" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc SectionPlaying}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="SessionList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="SessionRow_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="2,3">
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentDevice, Converter={StaticResource DeviceNameConverter}}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding VolumeText}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Grid.Column="2" Content="{Binding MuteIcon}" Click="MuteButton_Click"
                                        Background="Transparent" BorderThickness="0" FontSize="12"
                                        Cursor="Hand" VerticalAlignment="Center" Padding="0"
                                        ToolTip="{loc:Loc TipMuteToggle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SessionEmptyHint" Text="{loc:Loc HintNoSessions}" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="2,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 场景 -->
            <StackPanel x:Name="ProfileSection" DockPanel.Dock="Top" Margin="12,12,12,0">
                <TextBlock Text="{loc:Loc LabelProfile}" FontSize="12" FontWeight="SemiBold"/>
                <WrapPanel x:Name="ProfileList" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 底部操作 -->
            <Grid DockPanel.Dock="Bottom" Margin="12,12,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc BtnOpenMain}" Style="{StaticResource GhostButton}"
                        Padding="8,4" FontSize="12" Click="OpenMain_Click"/>
                <Button Grid.Column="2" Content="{loc:Loc BtnExit}" Style="{StaticResource GhostButton}"
                        Padding="8,4" FontSize="12" Click="Exit_Click"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
